# Keep the build context to what `go build ./cmd/...` actually needs: go.mod,
# go.sum and the Go source tree. Everything else only makes the context bigger
# and the layer cache more fragile.

# VCS and CI
.git
.gitignore
.github
.golangci.yml
.pre-commit-config.yaml

# Agent / editor state
.claude
.superpowers
.vscode
.idea
.DS_Store

# Docs and prose (the build never reads them)
docs
*.md
LICENSE

# Build artifacts produced outside the container
/tether
/tetherd
dist/
*.exe
*.test
*-go-tmp-umask
*.go.[0-9]*
.fuse_hidden*

# Local runtime state and test output
*.db
*.db-wal
*.db-shm
*.log
*.out
coverage.*
*.coverprofile
profile.cov

# Docker's own files
Dockerfile
.dockerignore
